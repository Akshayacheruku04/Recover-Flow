# ==============================================================================
# RECOVERFLOW / RAZORPAY BUILDATHON ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- RAZORPAY CONFIGURATION ---
# Found in Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- AI CONFIGURATION ---
# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- META WHATSAPP BUSINESS CLOUD API CONFIGURATION ---
# Set to 'false' to enable live WhatsApp outreach via Meta Graph API.
# When 'true' (default), RecoverFlow runs in safe Demo/Simulation mode.
WHATSAPP_DEMO_MODE=true

# Meta Graph API Token (System User Permanent Token or Temporary Developer Token)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# Meta WhatsApp Business Phone Number ID (from WhatsApp App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Meta Graph API Version (Default: v19.0)
WHATSAPP_API_VERSION=v19.0

# Pre-approved WhatsApp Template Name in Meta WhatsApp Business Manager
WHATSAPP_TEMPLATE_NAME=payment_recovery

# WhatsApp Template Language Code (e.g. en, en_US)
WHATSAPP_TEMPLATE_LANGUAGE=en

# Verification Token for Meta Webhook Verification (GET /webhook/whatsapp)
WHATSAPP_VERIFY_TOKEN=recoverflow_whatsapp_verify_token

# --- RECOVERY & FIREWALL POLICY CONTROLS ---
# High-Value Recovery Threshold in INR (Payments above this require Human-in-the-Loop review)
HIGH_VALUE_THRESHOLD=50000
